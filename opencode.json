{
  "$schema": "https://opencode.ai/config.json",
  "model": "qwen-local/qwen/qwen3.5-35b-a3b",
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  "provider": {
    "anthropic": {
      "api": "anthropic",
      "name": "Anthropic (Primary)"
    },
    "openai": {
      "api": "openai-completions",
      "name": "OpenAI (Fallback)"
    },
    "github-copilot": {
      "api": "github-copilot",
      "name": "GitHub Copilot"
    },
    "github-copilot-2": {
      "name": "GitHub Copilot (Account 2)"
    },
    "qwen-local": {
      "api": "openai-completions",
      "name": "Qwen Local",
      "models": {
        "zai-org/glm-4.7-flash": {
          "id": "zai-org/glm-4.7-flash",
          "name": "GLM 4.7 Flash",
          "family": "glm",
          "reasoning": true,
          "tool_call": true,
          "temperature": true
        },
        "qwen/qwen3.5-35b-a3b": {
          "id": "qwen/qwen3.5-35b-a3b",
          "name": "Qwen 3.5 35B A3B",
          "family": "qwen",
          "reasoning": true,
          "tool_call": true,
          "temperature": true
        }
      },
      "options": {
        "baseURL": "http://192.168.31.103:1234/v1"
      }
    }
  },
  "plugin": [
    "./opencode-fork/.opencode/plugins/orchestrator-plugin.ts",
    "./opencode-fork/.opencode/plugins/task-graph-plugin.ts",
    "./opencode-fork/.opencode/plugins/hashline-edit-plugin.ts",
    "./opencode-fork/.opencode/plugins/context-injection-plugin.ts",
    "./opencode-fork/.opencode/plugins/tmux-plugin.ts",
    "./opencode-fork/.opencode/plugins/skills-plugin.ts",
    "./opencode-fork/.opencode/tools/session-tools.ts"
  ],
  "mcp": {
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/exa-mcp-server"],
      "environment": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/context7-mcp-server"]
    },
    "grep-app": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/grep-app-mcp-server"]
    }
  }
}
