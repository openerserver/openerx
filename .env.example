# Server-side only. Never expose this value to the desktop renderer or commit a real key.
DEEPSEEK_API_KEY=sk-replace-with-your-key
DEEPSEEK_MODEL=deepseek-v4-flash
# Fallback for direct/legacy calls only; product chat sends its conversation thinkingLevel.
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_MS=120000

# Local V2 desktop + Platform Gateway development runtime.
OPENERX_PLATFORM_PORT=4099
OPENERX_DEV_EMAIL_CODE=123456
OPENERX_DEV_EMAIL=desktop-dev@openerx.local
OPENERX_DEV_PAYMENT_SECRET=replace-for-local-callback-testing
