{
  "name": "@opener-x/control-plane-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate:pg": "bun run db:generate",
    "db:migrate:pg": "bun run db:migrate",
    "db:seed:pg": "bun run db:seed",
    "db:studio:pg": "bun run db:studio",
    "db:export:sqlite": "bun run src/db/migration/export-sqlite.ts",
    "db:transform:sqlite-export": "bun run src/db/migration/transform-export.ts",
    "db:import:pg": "bun run src/db/migration/import-postgres.ts",
    "db:validate:pg": "bun run src/db/migration/validate-postgres.ts",
    "db:migrate:sqlite-snapshot": "bun run src/db/migration/sqlite-to-postgres.ts",
    "cli:task": "bun run src/cli/create-task.ts",
    "cli:backfill-task-relations": "bun run src/cli/backfill-project-task-relations.ts",
    "test": "bun test ../../tests/service --timeout 30000",
    "test:identity": "bun test ../../tests/service/identity-binding.test.ts --timeout 30000",
    "test:user-management": "bun test ../../tests/service/user-management.test.ts --timeout 30000"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@opencode-ai/sdk": "^1.0.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  }
}
