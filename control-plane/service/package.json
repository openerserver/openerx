{
  "name": "@opener-x/control-plane-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:reconcile:migration-state": "bun run src/db/migration/reconcile-postgres-migration-state.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate:pg": "bun run db:generate",
    "db:migrate:pg": "bun run db:migrate",
    "db:seed:pg": "bun run db:seed",
    "db:studio:pg": "bun run db:studio",
    "db:audit:task-domain": "bun run src/db/migration/audit-task-domain-consistency.ts",
    "db:cleanup:task-domain-audit-fixtures": "bun run src/db/migration/cleanup-task-domain-audit-fixtures.ts",
    "db:cleanup:invalid-configured-model-routes": "bun run src/db/migration/cleanup-invalid-configured-model-routes.ts",
    "db:backfill:parallel-candidate-user-prompts": "bun run src/db/migration/backfill-parallel-candidate-user-prompts.ts",
    "db:backfill:assistant-toolcall-stop-duplicates": "bun run src/db/migration/backfill-assistant-toolcall-stop-duplicates.ts",
    "cli:task": "bun run src/cli/create-task.ts",
    "test": "AUTH_RATE_LIMIT_LOGIN_IP_MAX=10000 AUTH_RATE_LIMIT_LOGIN_IDENTIFIER_MAX=10000 AUTH_RATE_LIMIT_REGISTER_IP_MAX=10000 AUTH_RATE_LIMIT_REGISTER_IDENTIFIER_MAX=10000 bun test ../../tests/service --timeout 30000",
    "test:identity": "bun test ../../tests/service/identity-binding.test.ts --timeout 30000",
    "test:user-management": "bun test ../../tests/service/user-management.test.ts --timeout 30000"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  }
}
