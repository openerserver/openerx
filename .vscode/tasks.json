			"command": "zsh",
			"args": [
				"-lc",
				"pids=$(lsof -ti tcp:4098 -sTCP:LISTEN 2>/dev/null || true); if [[ -n \"$pids\" ]]; then kill $pids; sleep 1; fi; cd control-plane/app && UI_DEV_SERVER_URL=${UI_DEV_SERVER_URL:-http://127.0.0.1:5173} exec bun run dev"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^(.*)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
