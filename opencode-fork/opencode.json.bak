{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gemini-3-flash-preview",
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  "provider": {
    "anthropic": {
      "api": "anthropic",
      "name": "Anthropic (Primary)"
    },
    "openai": {
      "api": "openai-completions",
      "name": "OpenAI (Fallback)"
    },
    "github-copilot": {
      "api": "github-copilot",
      "name": "GitHub Copilot"
    },
    "qwen-local": {
      "api": "openai-completions",
      "name": "Qwen Local",
      "models": {
        "zai-org/glm-4.7-flash": {
          "id": "zai-org/glm-4.7-flash",
          "name": "GLM 4.7 Flash",
          "family": "glm",
          "reasoning": true,
          "tool_call": true,
          "temperature": true
        },
        "qwen/qwen3.5-35b-a3b": {
          "id": "qwen/qwen3.5-35b-a3b",
          "name": "Qwen 3.5 35B A3B",
          "family": "qwen",
          "reasoning": true,
          "tool_call": true,
          "temperature": true
        }
      },
      "options": {
        "baseURL": "http://192.168.1.103:8000/v1",
        "apiKey": "1234"
      }
    }
  },
  "plugin": [
    "./.opencode/plugins/orchestrator-plugin.ts",
    "./.opencode/plugins/hashline-edit-plugin.ts",
    "./.opencode/plugins/context-injection-plugin.ts",
    "./.opencode/plugins/tmux-plugin.ts",
    "./.opencode/plugins/skills-plugin.ts",
    "./.opencode/tools/session-tools.ts"
  ],
  "mcp": {
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/exa-mcp-server"],
      "environment": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/context7-mcp-server"]
    },
    "grep-app": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/grep-app-mcp-server"]
    },
    "demo-memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "description": "Demo memory MCP for validation"
    }
  },
  "agents": {
    "defaults": {
      "model": "github-copilot:gemini-3-flash-preview",
      "provider": "github-copilot"
    }
  },
  "models": {
    "providers": {
      "qwen-local": {
        "api": "openai-completions",
        "name": "Qwen Local",
        "baseURL": "http://192.168.31.103:8000/v1",
        "apiKey": "1234"
      },
      "github-copilot": {
        "api": "github-copilot",
        "name": "GitHub Copilot"
      },
      "github-copilot-2": {
        "api": "github-copilot",
        "name": "GitHub Copilot (账号 2)"
      }
    },
    "list": [
      {
        "id": "gpt-5.4",
        "name": "GPT-5.4",
        "provider": "github-copilot",
        "contextWindow": 400000,
        "maxTokens": 128000
      },
      {
        "id": "claude-opus-4.6",
        "name": "Claude Opus 4.6",
        "provider": "github-copilot",
        "contextWindow": 144000,
        "maxTokens": 64000
      },
      {
        "id": "gemini-3-flash-preview",
        "name": "Gemini 3 Flash (Preview)",
        "provider": "github-copilot",
        "contextWindow": 128000,
        "maxTokens": 64000
      },
      {
        "id": "gpt-5.3-codex",
        "name": "GPT-5.3-Codex",
        "provider": "github-copilot",
        "contextWindow": 400000,
        "maxTokens": 128000
      },
      {
        "id": "Qwen3.5-122B-A10B-4bit",
        "name": "Qwen3.5-122B-A10B-4bit",
        "provider": "qwen-local",
        "contextWindow": 200000,
        "maxTokens": 16384
      },
      {
        "id": "gpt-4o",
        "name": "GPT-4o",
        "provider": "github-copilot"
      },
      {
        "id": "claude-sonnet-4.6",
        "name": "Claude Sonnet 4.6",
        "provider": "github-copilot",
        "contextWindow": 200000,
        "maxTokens": 32000
      }
    ]
  }
}
