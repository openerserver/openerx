{
  "manifest_version": 3,
  "name": "openerx Browser Bridge",
  "version": "0.2.0",
  "description": "Connect your browser and manage website access in the desktop app.",
  "key": "",
  "permissions": ["tabs", "debugger", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "openerx 浏览器连接"
  }
}
