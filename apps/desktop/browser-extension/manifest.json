{
  "manifest_version": 3,
  "name": "OpenERX Browser Bridge",
  "version": "0.1.0",
  "description": "Only control the tab you explicitly authorize in OpenERX.",
  "key": "",
  "permissions": ["activeTab", "debugger", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenERX 浏览器授权"
  }
}
