    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openerx/contracts": "0.0.0",
    "@openerx/remote-protocol": "0.0.0",
    "expo": "~57.0.16",
    "expo-camera": "57.0.4",
    "expo-crypto": "57.0.2",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.5",
    "expo-image-picker": "57.0.13",
    "expo-local-authentication": "57.0.2",
    "expo-notifications": "57.0.14",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-updates": "57.0.17",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
