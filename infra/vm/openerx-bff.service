[Unit]
Description=Opener-X Web UI BFF
After=network.target openerx-control-plane.service
Wants=openerx-control-plane.service

[Service]
Type=simple
User=openerx
Group=openerx
WorkingDirectory=/opt/openerx/control-plane/web-ui-bff
EnvironmentFile=/opt/openerx/.env
ExecStart=/root/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openerx-bff

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/openerx/data /opt/openerx/logs
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
