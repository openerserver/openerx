[Unit]
Description=OpenerX Control Plane API
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=openerx
Group=openerx
WorkingDirectory=/opt/openerx/control-plane/service
EnvironmentFile=/opt/openerx/.env
ExecStart=/root/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openerx-control-plane

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/openerx/data /opt/openerx/logs
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
