[Unit]
Description=OpenerX OpenCode Runtime (serve mode)
After=network.target
Before=openerx-bff.service
Wants=network-online.target

[Service]
Type=simple
User=openerx
Group=openerx
WorkingDirectory=/opt/openerx
EnvironmentFile=/opt/openerx/.env
ExecStart=/usr/local/bin/opencode serve --port 4096
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openerx-opencode

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/openerx/data /opt/openerx/logs /opt/openerx/.opencode
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
