{
  "name": "openerx",
  "private": true,
  "workspaces": ["control-plane/service", "control-plane/web-ui-bff", "control-plane/web-ui"],
  "scripts": {
    "dev:service": "cd control-plane/service && bun run dev",
    "dev:bff": "cd control-plane/web-ui-bff && bun run dev",
    "dev:ui": "cd control-plane/web-ui && bun run dev",
    "dev": "bun run dev:service & bun run dev:bff & bun run dev:ui",
    "build": "bun run build:service && bun run build:bff && bun run build:ui",
    "build:service": "cd control-plane/service && bun run build",
    "build:bff": "cd control-plane/web-ui-bff && bun run build",
    "build:ui": "cd control-plane/web-ui && bun run build",
    "test:service": "cd control-plane/service && bun run test",
    "test:bff": "cd control-plane/web-ui-bff && bun run test",
    "test:bff:chat-settings": "cd control-plane/web-ui-bff && bun test ../../tests/web-ui-bff/chat-settings-routes.test.ts --timeout 120000",
    "test:bff:realtime-regression": "cd control-plane/web-ui-bff && bun run test:realtime-regression",
    "test:ui": "cd control-plane/web-ui && bun run test",
    "test:ui:chat-settings": "cd control-plane/web-ui && bun run test -- ../../tests/web-ui/ChatSettings.test.ts",
    "test:ui:file": "cd control-plane/web-ui && bun run test --",
    "test:chat-settings:regression": "bun run test:bff:chat-settings && bun run test:ui:chat-settings",
    "test:e2e:chat-settings": "playwright test tests/e2e/chat-settings-admin.spec.ts",
    "test:chat-settings:ci": "bun run test:chat-settings:regression && bun run test:e2e:chat-settings",
    "test:all": "bun run test:service && bun run test:bff && bun run test:ui",
    "test:bff:completion-sync": "cd control-plane/web-ui-bff && bun run test:integration:completion-sync",
    "test:identity": "cd control-plane/service && bun run test:identity",
    "test:bff:identity": "cd control-plane/web-ui-bff && bun run test:identity",
    "test:bff:external-execute": "cd control-plane/web-ui-bff && bun run test:external-execute",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck:service": "cd control-plane/service && bun run typecheck",
    "typecheck:bff": "cd control-plane/web-ui-bff && bun run typecheck",
    "typecheck:ui": "cd control-plane/web-ui && bun run typecheck",
    "typecheck": "bun run typecheck:service && bun run typecheck:bff && bun run typecheck:ui",
    "check:all": "bash scripts/check-all.sh",
    "opencode:health": "bash scripts/opencode-health-check.sh",
    "opencode:cleanup": "bash scripts/opencode-cleanup.sh",
    "cli:task": "cd control-plane/service && bun run cli:task"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@biomejs/biome": "^1.9.0",
    "bun-types": "^1.3.10",
    "typescript": "^5.7.0"
  }
}
